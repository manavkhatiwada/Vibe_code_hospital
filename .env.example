# Copy to .env for local dev. In Railway/Render, set these as real environment variables instead.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset locally to use SQLite. Set to the Postgres connection string in production.
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ADMIN_EMAIL=admin@hospital.local
ADMIN_PASSWORD=change-this-password
ADMIN_USERNAME=admin
GEMINI_API_KEY=
